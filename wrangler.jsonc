{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blogpages",
	"compatibility_date": "2026-04-09",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",   // 如果需要 SPA 路由
		"html_handling": "auto-trailing-slash"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	] 
}